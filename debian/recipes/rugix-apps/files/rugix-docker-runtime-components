#!/usr/bin/env bash

set -euo pipefail

COMPONENTS_DIR="${RUGIX_COMPONENTS_DIR:-/run/rugix/components}"
OUTPUT_FILE="${RUGIX_DOCKER_COMPONENT_FILE:-${COMPONENTS_DIR}/docker.toml}"
tmp=""

cleanup() {
    if [ -n "${tmp}" ]; then
        rm -f "${tmp}"
    fi
}
trap cleanup EXIT

toml_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

normalize_version() {
    local version="${1#v}"
    if [[ "${version}" =~ ^[0-9]+(\.[0-9]+)*(-[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*)?(\+[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*)?$ ]]; then
        printf '%s\n' "${version}"
    fi
}

append_capability() {
    local id="$1"
    local raw_version="${2:-}"
    local version=""

    if [ -n "${raw_version}" ]; then
        version=$(normalize_version "${raw_version}" || true)
    fi

    printf '\n[[provides]]\nid = "%s"\n' "${id}" >>"${tmp}"
    if [ -n "${version}" ]; then
        printf 'version = "%s"\n' "${version}" >>"${tmp}"
    elif [ -n "${raw_version}" ]; then
        printf 'value = "%s"\n' "$(toml_escape "${raw_version}")" >>"${tmp}"
    fi
}

docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null \
    || docker version --format '{{.Client.Version}}' 2>/dev/null \
    || true)
compose_version=$(docker compose version --short 2>/dev/null || true)

if [ -z "${docker_version}" ] && [ -z "${compose_version}" ]; then
    rm -f "${OUTPUT_FILE}"
    exit 0
fi

mkdir -p "$(dirname "${OUTPUT_FILE}")"
tmp=$(mktemp "$(dirname "${OUTPUT_FILE}")/.docker.toml.tmp.XXXXXX")

cat >"${tmp}" <<EOF
# Generated by rugix-docker-runtime-components. Do not edit.
id = "runtime.docker"
EOF

normalized_docker_version=$(normalize_version "${docker_version}" || true)
if [ -n "${normalized_docker_version}" ]; then
    printf 'version = "%s"\n' "${normalized_docker_version}" >>"${tmp}"
elif [ -n "${docker_version}" ]; then
    append_capability "runtime.docker" "${docker_version}"
fi

if [ -n "${compose_version}" ]; then
    append_capability "runtime.docker-compose" "${compose_version}"
fi

chmod 0644 "${tmp}"
mv "${tmp}" "${OUTPUT_FILE}"
tmp=""
